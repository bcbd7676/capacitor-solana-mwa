# Normalise to LF in the repository. Without this, a Windows checkout commits
# CRLF and `gradlew` becomes unrunnable on Linux and macOS -- the shell reads the
# trailing CR as part of the interpreter path and reports "bad interpreter".
* text=auto eol=lf

# gradlew must stay LF and executable no matter who clones it.
gradlew text eol=lf
gradlew.bat text eol=crlf

*.jar binary
*.png binary
