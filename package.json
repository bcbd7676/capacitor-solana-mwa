{
  "name": "capacitor-solana-mwa",
  "version": "0.1.0",
  "description": "Solana Mobile Wallet Adapter for Capacitor. Native transport, so it needs no cleartext-traffic exemption -- unlike the JS MWA libraries, which cannot connect from a Capacitor WebView without one.",
  "license": "MIT",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "capacitor",
    "solana",
    "mobile-wallet-adapter",
    "mwa",
    "seed-vault",
    "solana-mobile",
    "android"
  ],
  "capacitor": {
    "android": {
      "src": "android"
    }
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "npm run clean && tsc && npm run build:cjs",
    "clean": "rimraf ./dist",
    "verify:android": "cd android && ./gradlew clean build test && cd ..",
    "build:cjs": "esbuild src/index.ts --bundle --format=cjs --platform=neutral --external:@capacitor/core --outfile=dist/plugin.cjs.js"
  },
  "devDependencies": {
    "@capacitor/core": "^8.0.0",
    "rimraf": "^5.0.0",
    "typescript": "~5.4.0",
    "esbuild": "^0.28.0"
  },
  "peerDependencies": {
    "@capacitor/core": ">=6.0.0"
  }
}
